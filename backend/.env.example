PORT=5000
NODE_ENV=development

# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ebr_inventory?retryWrites=true&w=majority
# Local:  mongodb://localhost:27017/ebr_inventory?replicaSet=rs0&directConnection=true
MONGO_URI=mongodb://localhost:27017/ebr_inventory?replicaSet=rs0&directConnection=true
# Overrides any database name in MONGO_URI
MONGO_DB_NAME=ebr_inventory

CLIENT_ORIGIN=http://localhost:5173

# Auth: generate with  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
SEED_ADMIN_ID=admin
# Used once by `npm run seed:admin` (min 8 chars)
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_NAME=Administrator
